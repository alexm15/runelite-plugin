{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "gradle: build",
			"type": "shell",
			"command": "./gradlew build",
			"windows": { "command": ".\\gradlew.bat build" },
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "gradle: run RuneLite (developer mode)",
			"type": "shell",
			"command": "./gradlew run",
			"windows": { "command": ".\\gradlew.bat run" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "check",
			"type": "shell",
			"command": "./scripts/check.sh",
			"windows": { "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check.ps1" },
			"group": "test",
			"problemMatcher": []
		}
	]
}
